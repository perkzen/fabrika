{
  "name": "@perkzen/fabrika",
  "version": "0.0.4",
  "description": "An Effect-based runner that drives Claude Code through spec, plan, implement, refactor, security and review stages on a ticket.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/perkzen/fabrika.git"
  },
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "fabrika": "dist/cli.js"
  },
  "files": [
    "dist",
    "skills",
    "prompts",
    ".claude-plugin",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "fabrika": "node src/cli.ts",
    "smoke": "node scripts/smoke.ts",
    "compile": "tsc --noEmit",
    "test": "node --test 'test/*.test.ts'",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "version": "node scripts/sync-version.ts"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.23.1",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-rc.113",
    "@effect/platform-node-shared": "4.0.0-rc.113",
    "effect": "4.0.0-rc.113",
    "marked": "^18.0.13"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "redis"
      ]
    }
  }
}
